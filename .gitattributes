# The compiler source ships as one compressed tarball, 178 MB, which is too
# large for plain git. Everything else here is text or small.
compiler/*.tar.zst filter=lfs diff=lfs merge=lfs -text
data/paper_figures/*.pdf filter=lfs diff=lfs merge=lfs -text
data/paper_figures/*.png filter=lfs diff=lfs merge=lfs -text
