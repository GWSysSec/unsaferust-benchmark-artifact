+                    RandomGen::Simple => Self::simple(rng),
+                    RandomGen::SimpleSigned => Self::simple_signed(rng),
+                    RandomGen::Large => Self::large(rng),
+                    RandomGen::LargeSigned => Self::large_signed(rng),
