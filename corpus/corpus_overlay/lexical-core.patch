+/// Parse JSON data as a given type.
+macro_rules! json_data {
+    ($t:ty, $file:literal) => {
+        fn json_data() -> &'static $t {
+            use lazy_static::lazy_static;
+            lazy_static! {
+                static ref DATA: $t = input::read_json($file);
+            }
+            &*DATA
+        }
+    };
+}
