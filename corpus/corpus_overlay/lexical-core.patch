+// RANDOM
+
+#[derive(Copy, Clone, PartialEq, Eq)]
+pub enum RandomGen {
+    // Generic
+    Uniform,
+
+    // Integers
+    Simple,
+    SimpleSigned,
+    Large,
+    LargeSigned,
+
+    // Floats
+    OneOverRand32,
+    SimpleUniform32,
+    SimpleInt32,
+    IntEInt,
+    SimpleInt64,
+    BigIntDotInt,
+    BigInts,
+}
+
+pub trait NumberRng: Sized + ToString {
+    fn gen(strategy: RandomGen, rng: &mut Rng) -> String;
+}
